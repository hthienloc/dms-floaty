{
  "id": "floaty",
  "name": "Floaty",
  "description": "A feature-rich reference image tool to float images, screenshots, and vector graphics on top of all windows.",
  "version": "2.0.0",
  "author": "Loc Huynh",
  "icon": "cloud",
  "type": "composite",
  "capabilities": [
    "daemon",
    "dankbar-widget",
    "ipc"
  ],
  "components": {
    "daemon": "./FloatyDaemon.qml",
    "widget": "./FloatyWidget.qml"
  },
  "settings": "./FloatySettings.qml",
  "requires_dms": ">=1.5.0",
  "permissions": [
    "settings_read",
    "settings_write",
    "process",
    "clipboard_read"
  ]
}
